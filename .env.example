# Copy this file to .env, then load it before starting the backend:
# set -a; . ./.env; set +a

SLOPSHOTS_DATA_DIR=backend/data
SLOPSHOTS_FFMPEG_BIN=ffmpeg
SLOPSHOTS_FFPROBE_BIN=ffprobe

SLOPSHOTS_KOKORO_VOICE=af_heart
SLOPSHOTS_KOKORO_LANGUAGE=a
SLOPSHOTS_KOKORO_SPEED=1.0

SLOPSHOTS_WHISPERX_MODEL=small
SLOPSHOTS_WHISPERX_DEVICE=cpu
SLOPSHOTS_WHISPERX_COMPUTE_TYPE=int8

# OpenCode Zen's OpenAI-compatible endpoint. Create an API key at
# https://opencode.ai/zen and keep it server-side; do not expose it in Vite.
SLOPSHOTS_OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
SLOPSHOTS_OPENCODE_ZEN_API_KEY=
SLOPSHOTS_OPENCODE_ZEN_MODEL=deepseek-v4-flash-free

SLOPSHOTS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
